# Copy to a gitignored `portfolio.auto.tfvars` and replace every placeholder.
# This file contains no account ID, email address, credential, secret or live
# endpoint. The validations deliberately reject these placeholders.

# The live value belongs only in the ignored, mode-600 local tfvars file.
# The AWS provider refuses to operate if its caller resolves to another account.
expected_aws_account_id = "REPLACE_WITH_12_DIGIT_ACCOUNT_ID"

resource_suffix = "REPLACE"

release_commit_sha = "REPLACE_WITH_FULL_LOWERCASE_40_HEX_COMMIT_SHA"

# SHA-256 digest only. Never put the plaintext portfolio token in Terraform.
portfolio_token_sha256 = "REPLACE_WITH_64_HEX_CHARACTERS"

# Generate 32 random bytes outside the repository and encode them as exactly
# 64 lowercase hex characters. Both values are sensitive and enter Terraform
# state and AWS Secrets Manager. Normal state is active A + accepted [A].
origin_verify_active_value    = "REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS"
origin_verify_accepted_values = ["REPLACE_WITH_THE_SAME_64_LOWERCASE_HEX_CHARACTERS"]

# Required owner-approved destination. Do not commit a personal address.
budget_alert_email = "REPLACE_WITH_APPROVED_ALERT_RECIPIENT"

# Both services stay off for the bootstrap/migration apply. Enable the API only
# in a separately reviewed apply after the one-shot migration exits zero.
api_desired_count    = 0
worker_desired_count = 0

# False is the keyless fake-provider baseline. Set true only for the bounded
# G12 plan after an OpenAI secret version has been added outside Terraform.
enable_g12_openai = false
