# Worker-image dependency intent — the FULL pipeline stack run_job.py can reach
# (mirrors the pipeline entries of the root requirements.txt; flask/flask-cors are
# server-only and deliberately excluded — nothing in the run_job.py import chain
# touches them). Compile with:
#
#   uv pip compile services/worker/requirements.in -o services/worker/requirements.txt \
#     --python-version 3.12 --python-platform x86_64-unknown-linux-gnu \
#     --index-strategy unsafe-best-match --emit-index-url
#
# The extra index provides CPU-only torch wheels (+cpu local version) so the
# linux/amd64 image does not pull the multi-GB CUDA dependency tree.
--extra-index-url https://download.pytorch.org/whl/cpu

# Vision/text/TTS provider clients (OpenAI SDK also backs gemini/local compat paths)
openai>=1.0
