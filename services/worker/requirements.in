# Audio: speech detection + transcription for gap-aware AD placement.
# torch is pinned to torchaudio's minor (2.11): torchaudio stopped lockstep
# releases after 2.11 and its compiled extensions target the matching torch —
# an unpinned resolve drifts to torch 2.13.0+cpu alongside torchaudio
# 2.11.0+cpu, an unproven ABI pair. The G5 image build exercises a real
# torchaudio op (not just imports) to keep this pair honest.
faster-whisper>=1.0
